// ======================================================
// DATABASE PROJECT SUPERMARKET
// ======================================================


// ======================================================
// 1. TABEL USER / LOGIN
// ======================================================

Table users {
    id int [pk, increment]
    username varchar [not null, unique]
    password varchar [not null]
    role varchar [not null] // admin, kasir, manager
    created_at datetime
}


// ======================================================
// 2. TABEL PEGAWAI
// ======================================================

Table pegawai {
    id int [pk, increment]
    user_id int [not null]
    nama varchar [not null]
    alamat varchar
    no_hp varchar
    jabatan varchar
    tanggal_masuk date
    status varchar
}


// ======================================================
// 3. TABEL PELANGGAN
// ======================================================

Table pelanggan {
    id int [pk, increment]
    kode_pelanggan varchar [not null, unique]
    nama varchar [not null]
    alamat varchar
    no_hp varchar
    email varchar
    tanggal_daftar date
    poin int [default: 0]
}


// ======================================================
// 4. TABEL KATEGORI
// ======================================================

Table kategori {
    id int [pk, increment]
    kode_kategori varchar [not null, unique]
    nama_kategori varchar [not null]
    deskripsi text
}


// ======================================================
// 5. TABEL SATUAN
// ======================================================

Table satuan {
    id int [pk, increment]
    nama_satuan varchar [not null]
    keterangan varchar
}


// ======================================================
// 6. TABEL SUPPLIER
// ======================================================

Table supplier {
    id int [pk, increment]
    kode_supplier varchar [not null, unique]
    nama_supplier varchar [not null]
    alamat text
    no_hp varchar
    email varchar
    kontak_person varchar
    status varchar
}


// ======================================================
// 7. TABEL PRODUK
// ======================================================

Table produk {
    id int [pk, increment]
    kategori_id int [not null]
    satuan_id int [not null]
    supplier_id int
    kode_produk varchar [not null, unique]
    barcode varchar [unique]
    nama_produk varchar [not null]
    deskripsi text
    harga_beli decimal(15,2)
    harga_jual decimal(15,2)
    stok int [default: 0]
    stok_minimum int [default: 0]
    diskon decimal(5,2) [default: 0]
    tanggal_kadaluarsa date
    status varchar
    created_at datetime
}


// ======================================================
// 8. TABEL STOK
// ======================================================

Table stok {
    id int [pk, increment]
    produk_id int [not null]
    jumlah_stok int [default: 0]
    stok_masuk int [default: 0]
    stok_keluar int [default: 0]
    stok_minimum int [default: 0]
    lokasi_rak varchar
    updated_at datetime
}


// ======================================================
// 9. TABEL PEMBELIAN
// ======================================================

Table pembelian {
    id int [pk, increment]
    supplier_id int [not null]
    pegawai_id int [not null]
    no_faktur varchar [not null, unique]
    tanggal_pembelian datetime
    total_harga decimal(15,2)
    diskon decimal(15,2) [default: 0]
    pajak decimal(15,2) [default: 0]
    grand_total decimal(15,2)
    status varchar
}


// ======================================================
// 10. DETAIL PEMBELIAN
// ======================================================

Table detail_pembelian {
    id int [pk, increment]
    pembelian_id int [not null]
    produk_id int [not null]
    jumlah int [not null]
    harga_beli decimal(15,2)
    subtotal decimal(15,2)
}


// ======================================================
// 11. TABEL PENJUALAN
// ======================================================

Table penjualan {
    id int [pk, increment]
    pelanggan_id int
    pegawai_id int [not null]
    no_transaksi varchar [not null, unique]
    tanggal_penjualan datetime
    total_harga decimal(15,2)
    diskon decimal(15,2) [default: 0]
    pajak decimal(15,2) [default: 0]
    grand_total decimal(15,2)
    metode_pembayaran varchar
    status varchar
}


// ======================================================
// 12. DETAIL PENJUALAN
// ======================================================

Table detail_penjualan {
    id int [pk, increment]
    penjualan_id int [not null]
    produk_id int [not null]
    jumlah int [not null]
    harga decimal(15,2)
    diskon decimal(15,2) [default: 0]
    subtotal decimal(15,2)
}


// ======================================================
// 13. TABEL PEMBAYARAN
// ======================================================

Table pembayaran {
    id int [pk, increment]
    penjualan_id int [not null]
    tanggal_pembayaran datetime
    metode varchar [not null]
    jumlah_bayar decimal(15,2)
    nomor_referensi varchar
    status varchar
}


// ======================================================
// 14. TABEL PROMO
// ======================================================

Table promo {
    id int [pk, increment]
    kode_promo varchar [not null, unique]
    nama_promo varchar [not null]
    jenis_promo varchar
    nilai_promo decimal(15,2)
    tanggal_mulai date
    tanggal_selesai date
    minimal_pembelian decimal(15,2)
    status varchar
}


// ======================================================
// 15. DETAIL PROMO PRODUK
// ======================================================

Table promo_produk {
    id int [pk, increment]
    promo_id int [not null]
    produk_id int [not null]
}


// ======================================================
// 16. TABEL RETUR PENJUALAN
// ======================================================

Table retur_penjualan {
    id int [pk, increment]
    penjualan_id int [not null]
    pegawai_id int [not null]
    tanggal_retur datetime
    alasan text
    total_retur decimal(15,2)
    status varchar
}


// ======================================================
// 17. DETAIL RETUR PENJUALAN
// ======================================================

Table detail_retur_penjualan {
    id int [pk, increment]
    retur_id int [not null]
    produk_id int [not null]
    jumlah int [not null]
    harga decimal(15,2)
    subtotal decimal(15,2)
}


// ======================================================
// 18. TABEL RETUR PEMBELIAN
// ======================================================

Table retur_pembelian {
    id int [pk, increment]
    pembelian_id int [not null]
    supplier_id int [not null]
    pegawai_id int [not null]
    tanggal_retur datetime
    alasan text
    total_retur decimal(15,2)
    status varchar
}


// ======================================================
// 19. DETAIL RETUR PEMBELIAN
// ======================================================

Table detail_retur_pembelian {
    id int [pk, increment]
    retur_id int [not null]
    produk_id int [not null]
    jumlah int [not null]
    harga decimal(15,2)
    subtotal decimal(15,2)
}


// ======================================================
// 20. TABEL SHIFT KASIR
// ======================================================

Table shift_kasir {
    id int [pk, increment]
    pegawai_id int [not null]
    waktu_mulai datetime
    waktu_selesai datetime
    modal_awal decimal(15,2)
    total_penjualan decimal(15,2)
    uang_fisik decimal(15,2)
    selisih decimal(15,2)
    status varchar
}


// ======================================================
// 21. TABEL KAS
// ======================================================

Table kas {
    id int [pk, increment]
    pegawai_id int [not null]
    jenis varchar // masuk / keluar
    kategori varchar
    keterangan text
    jumlah decimal(15,2)
    tanggal datetime
}


// ======================================================
// 22. TABEL SUPPLIER PRODUK
// ======================================================

Table supplier_produk {
    id int [pk, increment]
    supplier_id int [not null]
    produk_id int [not null]
    harga_supplier decimal(15,2)
    waktu_pengiriman int
    status varchar
}


// ======================================================
// 23. TABEL LOG STOK
// ======================================================

Table log_stok {
    id int [pk, increment]
    produk_id int [not null]
    pegawai_id int [not null]
    jenis varchar // masuk / keluar / penyesuaian
    jumlah int
    stok_sebelum int
    stok_sesudah int
    keterangan text
    tanggal datetime
}


// ======================================================
// 24. TABEL MEMBER
// ======================================================

Table member {
    id int [pk, increment]
    pelanggan_id int [not null]
    nomor_member varchar [not null, unique]
    tipe_member varchar // silver / gold / platinum
    tanggal_mulai date
    tanggal_berakhir date
    poin int [default: 0]
    status varchar
}


// ======================================================
// 25. TABEL POIN MEMBER
// ======================================================

Table transaksi_poin {
    id int [pk, increment]
    member_id int [not null]
    penjualan_id int
    jenis varchar // tambah / kurang
    jumlah_poin int
    keterangan text
    tanggal datetime
}


// ======================================================
// RELATIONSHIP / RELASI DATABASE
// ======================================================


// USER -> PEGAWAI
Ref: pegawai.user_id > users.id


// KATEGORI -> PRODUK
Ref: produk.kategori_id > kategori.id


// SATUAN -> PRODUK
Ref: produk.satuan_id > satuan.id


// SUPPLIER -> PRODUK
Ref: produk.supplier_id > supplier.id


// PRODUK -> STOK
Ref: stok.produk_id - produk.id


// SUPPLIER -> PEMBELIAN
Ref: pembelian.supplier_id > supplier.id


// PEGAWAI -> PEMBELIAN
Ref: pembelian.pegawai_id > pegawai.id


// PEMBELIAN -> DETAIL PEMBELIAN
Ref: detail_pembelian.pembelian_id > pembelian.id


// PRODUK -> DETAIL PEMBELIAN
Ref: detail_pembelian.produk_id > produk.id


// PELANGGAN -> PENJUALAN
Ref: penjualan.pelanggan_id > pelanggan.id


// PEGAWAI -> PENJUALAN
Ref: penjualan.pegawai_id > pegawai.id


// PENJUALAN -> DETAIL PENJUALAN
Ref: detail_penjualan.penjualan_id > penjualan.id


// PRODUK -> DETAIL PENJUALAN
Ref: detail_penjualan.produk_id > produk.id


// PENJUALAN -> PEMBAYARAN
Ref: pembayaran.penjualan_id > penjualan.id


// PROMO -> PROMO PRODUK
Ref: promo_produk.promo_id > promo.id


// PRODUK -> PROMO PRODUK
Ref: promo_produk.produk_id > produk.id


// PENJUALAN -> RETUR PENJUALAN
Ref: retur_penjualan.penjualan_id > penjualan.id


// PEGAWAI -> RETUR PENJUALAN
Ref: retur_penjualan.pegawai_id > pegawai.id


// RETUR PENJUALAN -> DETAIL RETUR
Ref: detail_retur_penjualan.retur_id > retur_penjualan.id


// PRODUK -> DETAIL RETUR
Ref: detail_retur_penjualan.produk_id > produk.id


// PEMBELIAN -> RETUR PEMBELIAN
Ref: retur_pembelian.pembelian_id > pembelian.id


// SUPPLIER -> RETUR PEMBELIAN
Ref: retur_pembelian.supplier_id > supplier.id


// PEGAWAI -> RETUR PEMBELIAN
Ref: retur_pembelian.pegawai_id > pegawai.id


// RETUR PEMBELIAN -> DETAIL RETUR
Ref: detail_retur_pembelian.retur_id > retur_pembelian.id


// PRODUK -> DETAIL RETUR PEMBELIAN
Ref: detail_retur_pembelian.produk_id > produk.id


// PEGAWAI -> SHIFT KASIR
Ref: shift_kasir.pegawai_id > pegawai.id


// PEGAWAI -> KAS
Ref: kas.pegawai_id > pegawai.id


// SUPPLIER -> SUPPLIER PRODUK
Ref: supplier_produk.supplier_id > supplier.id


// PRODUK -> SUPPLIER PRODUK
Ref: supplier_produk.produk_id > produk.id


// PRODUK -> LOG STOK
Ref: log_stok.produk_id > produk.id


// PEGAWAI -> LOG STOK
Ref: log_stok.pegawai_id > pegawai.id


// PELANGGAN -> MEMBER
Ref: member.pelanggan_id - pelanggan.id


// MEMBER -> TRANSAKSI POIN
Ref: transaksi_poin.member_id > member.id


// PENJUALAN -> TRANSAKSI POIN
Ref: transaksi_poin.penjualan_id > penjualan.id